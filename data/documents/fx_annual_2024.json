    "groupDetail": {
        "label": "Annual exchange rates",
        "description": "Annual average exchange rates for various foreign currencies currently or historically published by the Bank of Canada, representing the value of one unit of foreign currency expressed in Canadian dollars. These rates are typically published on the last business day of each year by 12:30 (ET). All Bank of Canada exchange rates are indicative rates only, obtained from averages of aggregated price quotes from financial institutions.",
        "link": "https://www.bankofcanada.ca/?p=195751",
        "metadata": {
            "unit": "Canadian dollars per foreign currency unit",
            "frequency": "Annual"
        }
    },
